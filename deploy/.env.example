# Public IPv4 of this host. UDP and TCP 53 must be open on it.
PUBLIC_IP=151.115.96.14
# This instance's NS name, without trailing dot. Must have an A record (DNS only) in
# the parent zone pointing at PUBLIC_IP, and be listed in the parent's `NS ip` records.
NS_HOST=ns-ip.inojob.com
# SOA rname (hostmaster mailbox, dots instead of @), without trailing dot.
SOA_RNAME=dns.inojob.com
# SOA serial. Bump when the NS set changes.
SOA_SERIAL=2026102101

# Two-instance setup only (see docker-compose.peer.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.peer.yml
# NS_PEER=ns2-ip.nsl.sh
# NS_PEER_IP=203.0.113.20
