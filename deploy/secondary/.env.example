# Public IPv4 of this host. UDP and TCP 53 must be open on it.
PUBLIC_IP=151.115.96.14
# PUBLIC_PORT=53                     # another port for a side-by-side test
# The IP-encoded names zone served here, and every public NS name serving it
# (comma list, first = SOA mname). Each needs an A record in the parent zone and
# a matching `NS ip` delegation.
IP_ZONE=ip.inojob.com
NS_HOSTS=ns-ip.inojob.com
# SOA rname (hostmaster mailbox, dots instead of @), without trailing dot.
SOA_RNAME=dns.inojob.com
# The primary's catalog: the backend's DNS_CATALOG_ZONE (default catalog.<SERVER_DOMAIN>.invalid).
CATALOG_ZONE=catalog.inojob.com.invalid
# The primary as this node reaches it (co-located: the dns-xfr network address).
PRIMARY_IP=172.16.53.10
# PRIMARY_PORT=53
# XFR_IP=172.16.53.11                # this node on dns-xfr; must be in the primary's DNS_SECONDARY_IPS
